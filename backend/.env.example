# Catálogo Digital — exemplo sem segredos reais
ENVIRONMENT=development
DATABASE_URL=sqlite:///./catalogo.db
JWT_SECRET=troque-por-uma-chave-forte-com-mais-de-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

SENTRY_TRACES_SAMPLE_RATE=0.05
# SENTRY_DSN=

BILLING_DEFAULT_CURRENCY=BRL
BILLING_INVOICE_LEAD_DAYS=7
BILLING_GRACE_DAYS=5

# Backup/recuperação. Em produção, prefira configurar como GitHub Secrets,
# não neste arquivo e nunca no repositório.
# BACKUP_DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# BACKUP_ENCRYPTION_KEY=
# RESTORE_TEST_DATABASE_URL=postgresql://usuario:senha@host:5432/banco_teste

# Mercado Pago — Fase 24.7 (cobrança da assinatura SaaS via Pix)
# Configure somente no Render/ambiente seguro. Nunca coloque credenciais reais no Git.
# MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
# MERCADO_PAGO_WEBHOOK_SECRET=...
# MERCADO_PAGO_WEBHOOK_URL=https://catalogo-digital-api.onrender.com/api/billing/webhooks/mercado-pago

# Mercado Pago: use true apenas com credenciais/cenários de teste
MERCADO_PAGO_TEST_MODE=false

# Assistente IA — Fase 24.8.1
# Compatível com APIs no formato Chat Completions. Configure somente no backend/Render.
ASSISTANT_AI_ENABLED=false
# ASSISTANT_AI_API_URL=https://seu-provedor/v1/chat/completions
# ASSISTANT_AI_API_KEY=nao-commitar
# ASSISTANT_AI_MODEL=nome-do-modelo
ASSISTANT_AI_TIMEOUT_SECONDS=20
ASSISTANT_AI_MAX_TOKENS=320
ASSISTANT_AI_TEMPERATURE=0.2
ASSISTANT_AI_REQUESTS_PER_MINUTE=12

# Pagamentos dos clientes das lojas — Mercado Pago Marketplace/OAuth
# Crie uma aplicação Marketplace separada ou habilite o modelo Marketplace na aplicação usada para vendedores.
# MERCADO_PAGO_MARKETPLACE_APP_ID=1234567890123456
# MERCADO_PAGO_MARKETPLACE_CLIENT_ID=client-id-da-mesma-aplicacao
# MERCADO_PAGO_MARKETPLACE_CLIENT_SECRET=nao-commitar
# MERCADO_PAGO_MARKETPLACE_REDIRECT_URI=https://catalogo-digital-api.onrender.com/api/payment-gateways/mercado-pago/callback
# MERCADO_PAGO_MARKETPLACE_WEBHOOK_SECRET=nao-commitar
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# STORE_PAYMENT_CREDENTIALS_KEY=nao-commitar
STORE_PAYMENTS_TEST_MODE=false
# FRONTEND_PUBLIC_URL=https://catalogo-digital-v3zs.onrender.com
