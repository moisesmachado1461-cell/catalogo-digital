# ==========================================
# Catálogo Digital — exemplo de ambiente
# ==========================================

# Desenvolvimento local
ENVIRONMENT=development
DATABASE_URL=sqlite:///./catalogo.db
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=15
LOG_LEVEL=INFO

# Uploads locais (desenvolvimento)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Produção com armazenamento S3 compatível (Cloudflare R2 / AWS S3 etc.)
# STORAGE_PROVIDER=s3
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=nao-commitar
# S3_SECRET_ACCESS_KEY=nao-commitar
# S3_BUCKET_NAME=catalogo-digital-media
# S3_PUBLIC_BASE_URL=https://SEU-ENDERECO-PUBLICO-DO-BUCKET


# Produção com Cloudinary (alternativa recomendada nesta instalação)
# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=seu-cloud-name
# CLOUDINARY_API_KEY=nao-commitar
# CLOUDINARY_API_SECRET=nao-commitar

# Observabilidade opcional
# SENTRY_DSN=https://...
# SENTRY_TRACES_SAMPLE_RATE=0.05

# Produção (Render): configure no painel do serviço, nunca commit valores secretos.
# ENVIRONMENT=production
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# JWT_SECRET=gere-um-segredo-longo-e-aleatorio
# CORS_ORIGINS=https://catalogo-digital-v3zs.onrender.com
# API_PUBLIC_URL=https://catalogo-digital-api.onrender.com

# Cobrança da assinatura do SaaS (Fase 19)
# Credenciais específicas de gateways entram apenas nas próximas integrações.
BILLING_DEFAULT_CURRENCY=BRL
BILLING_INVOICE_LEAD_DAYS=7
BILLING_GRACE_DAYS=5

# Mercado Pago — Fase 24.7 (cobrança da assinatura SaaS via Pix)
# Configure somente no Render/ambiente seguro. Nunca coloque credenciais reais no Git.
# MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
# MERCADO_PAGO_WEBHOOK_SECRET=...
# MERCADO_PAGO_WEBHOOK_URL=https://catalogo-digital-api.onrender.com/api/billing/webhooks/mercado-pago
